# Сборка React SPA
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

# Копируем package файлы для кэширования зависимостей
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

# Копируем исходники
COPY . .

# Build args для VITE_ переменных
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY

# Vite читает import.meta.env — нужны ENV, а не только ARG
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_PUBLISHABLE_KEY=${VITE_SUPABASE_PUBLISHABLE_KEY}

# Собираем
RUN npm run build

# Prod — nginx для раздачи статики
FROM nginx:stable-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
RUN apk del curl nginx-module-xslt nginx-module-njs && apk upgrade --no-cache

# Копируем билд
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/frontend-entrypoint.sh /frontend-entrypoint.sh

RUN chmod +x /frontend-entrypoint.sh

# Nginx конфиг для SPA
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
        add_header Cache-Control "no-cache, no-store, must-revalidate"; \
        add_header Pragma "no-cache"; \
    } \
    location /assets/ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
    location = /sw.js { \
        add_header Cache-Control "no-cache, no-store, must-revalidate"; \
    } \
    location = /registerSW.js { \
        add_header Cache-Control "no-cache, no-store, must-revalidate"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["/frontend-entrypoint.sh"]
